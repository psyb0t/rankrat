# Copy to .env for local use. Do not put provider credential values in this file.
RANKRAT_BOUNDARY_FILE=/run/config/boundaries.json
RANKRAT_SECRET_ROOT=/run/secrets
# Required by Google Search Console, GA4, or Google Indexing accounts. This
# must be a dedicated owner-only writable mount, never a provider-secret mount.
RANKRAT_OAUTH_TOKEN_ROOT=/run/oauth
# Optional local Chromium/Lighthouse companion. The default is the companion's
# Unix socket; set this to an empty value when no worker will be mounted. The
# five operations remain discoverable and return a finite unavailable error.
RANKRAT_LIGHTHOUSE_WORKER_SOCKET=/run/lighthouse/lighthouse.sock
RANKRAT_LOG_FILE=/tmp/rankrat/rankrat.log
# The transport is selected by the command argument (`rankrat stdio` or
# `rankrat http`), which always overrides the parsed mode, so there is no
# RANKRAT_MODE entry here.
RANKRAT_HTTP_HOST=127.0.0.1
RANKRAT_HTTP_PORT=8080
RANKRAT_LOG_LEVEL=INFO
RANKRAT_ENABLE_OPENAPI=false
RANKRAT_READ_ONLY=true
# Bootstrap mode for a trusted caller. It keeps configured credential accounts
# fixed but permits resources outside their current allow-lists. It requires
# RANKRAT_READ_ONLY=false and should be turned off after onboarding persists the
# exact resource boundaries.
RANKRAT_UNBOUNDED=false
# Onboarding creates a GA4 property, a Search Console property and a Bing site,
# then rewrites this server's own boundary file to include them -- the only
# operation that widens its future scope. Writable mode alone does not expose it:
# leave this false and `site_onboarding_submit` is absent from tools/list and its
# REST route is not mounted, however writable the rest of the server is. The
# `rankrat onboard-site` command is unaffected; that one is a human at a terminal.
# Requires RANKRAT_READ_ONLY=false.
RANKRAT_ALLOW_AGENT_ONBOARDING=false

# Live provider checks are opt-in. Set selectors only for providers and
# resources you configured; leave every unused provider selector empty so its
# live check skips. Credentials always stay in the files referenced by
# config/boundaries.json.
RANKRAT_LIVE_GOOGLE_ACCOUNT_ID=
RANKRAT_LIVE_GOOGLE_SITE_URL=
RANKRAT_LIVE_GOOGLE_SITEMAP_URL=
RANKRAT_LIVE_GOOGLE_INSPECTION_URL=
RANKRAT_LIVE_GOOGLE_INDEXING_URL=
RANKRAT_LIVE_GA4_PROPERTY_ID=
RANKRAT_LIVE_GA4_FUNNEL_EVENTS=
RANKRAT_LIVE_PAGESPEED_ACCOUNT_ID=
RANKRAT_LIVE_PAGESPEED_SITE_URL=
RANKRAT_LIVE_PAGESPEED_URL=
RANKRAT_LIVE_BING_ACCOUNT_ID=
RANKRAT_LIVE_BING_SITE_URL=
RANKRAT_LIVE_BING_QUERY=
RANKRAT_LIVE_BING_PAGE_URL=
RANKRAT_LIVE_BING_KEYWORD_QUERY=
RANKRAT_LIVE_BING_COUNTRY=
RANKRAT_LIVE_BING_LANGUAGE=
RANKRAT_LIVE_INDEXNOW_TARGET_ID=
RANKRAT_LIVE_INDEXNOW_URL=
RANKRAT_RUN_LIVE_INDEXNOW_SUBMISSION=false

# Required only when RANKRAT_HTTP_HOST is not loopback.
# RANKRAT_HTTP_BEARER_SECRET_FILE=/run/secrets/rankrat/http-bearer-token

# Set RANKRAT_READ_ONLY=false only when the process should expose write tools.
# Writes remain limited to the configured account, site, property, and IndexNow
# boundaries. In read-only mode they are absent from REST and MCP discovery.
