# Optional runtime overrides; never put credentials here.
RANKRAT_IMAGE=psyb0t/rankrat:latest
RANKRAT_LIGHTHOUSE_IMAGE=psyb0t/rankrat-lighthouse:latest
RANKRAT_SCHEDULER_INTERVAL_SECONDS=60
RANKRAT_STATE_RETENTION_DAYS=180
RANKRAT_HTTP_PORT=8080
RANKRAT_LOG_LEVEL=INFO
RANKRAT_ENABLE_OPENAPI=false
RANKRAT_READ_ONLY=false
