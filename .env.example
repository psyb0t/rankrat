# Optional runtime overrides; never put credentials here.
# The rankrat wrapper pins both images to the latest release on setup and records
# them in a profile .env; set these only to override that pin for a run.
# These RANKRAT_* host vars can also live permanently in ~/.config/rankrat/.env
# (override the path with RANKRAT_ENV_FILE), which the wrapper reads before it
# selects a profile; a flag or a real env var still overrides that file.
RANKRAT_IMAGE=psyb0t/rankrat:latest
RANKRAT_LIGHTHOUSE_IMAGE=psyb0t/rankrat-lighthouse:latest
RANKRAT_SCHEDULER_INTERVAL_SECONDS=60
RANKRAT_STATE_RETENTION_DAYS=180
RANKRAT_HTTP_PORT=8080
RANKRAT_LOG_LEVEL=INFO
RANKRAT_ENABLE_OPENAPI=false
RANKRAT_READ_ONLY=false
